# ════════════════════════════════════════════════════════════════════
#  COPY THIS FILE TO .env AND FILL IN YOUR VALUES
#  .env is gitignored — never commit real credentials
# ════════════════════════════════════════════════════════════════════

# ─── Site URL ───────────────────────────────────────────────────────
# Use localhost for local dev. Set to live domain before deploying.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# NUXT_PUBLIC_SITE_URL=https://ahaladaroassociates.com   ← uncomment for production

# ─── Email destination ──────────────────────────────────────────────
# All contact-form and appointment emails are sent TO this address.
# Currently set to test email. Switch to official email before going live.
CONTACT_EMAIL=akshitareddybanala@gmail.com
# CONTACT_EMAIL=mail@ahaladaroassociates.com             ← uncomment for production

# ─── SMTP (Gmail recommended for testing) ───────────────────────────
#
#  HOW TO SET UP GMAIL FOR SENDING:
#  1. Go to your Google Account → Security → 2-Step Verification (turn ON)
#  2. Go to Security → App Passwords → Select app: "Mail" → Generate
#  3. Copy the 16-character password shown (no spaces)
#  4. Paste it as SMTP_PASS below
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The Gmail account that SENDS the emails (can be the same as CONTACT_EMAIL for testing)
SMTP_USER=akshitareddybanala@gmail.com

# 16-character Gmail App Password (NOT your regular Gmail password)
SMTP_PASS=xxxx xxxx xxxx xxxx

# ─── PRODUCTION SWITCH CHECKLIST ────────────────────────────────────
# When ready to go live, change:
#   NUXT_PUBLIC_SITE_URL  → https://ahaladaroassociates.com
#   CONTACT_EMAIL         → mail@ahaladaroassociates.com
#   SMTP_USER             → the Gmail/SMTP account used for sending
#   SMTP_PASS             → its App Password
